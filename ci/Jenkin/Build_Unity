pipeline {
    agent { label 'Kuzan-Window'}
    stages {
        stage('Checkout GIT') {
            steps {
				script {
					echo "Checkout branch = ${params.branch}"
					def scmConfig = [
							$class: 'GitSCM',
							branches: [[name: "${params.branch}"]],
							userRemoteConfigs: [],
							extensions: []
						]
					if (params.Clean) {
						scmConfig.extensions << [$class: 'CleanBeforeCheckout']
					}
					scmConfig.extensions << [
						$class: 'SubmoduleOption',
						recursiveSubmodules: true,
						reference: ''
					]
					checkout scmConfig
				}
            }
        }
        
        stage('Build with Unity') {
            steps {
                echo "jaksjdkajskd"
            }
        }
        
        stage('Sync to S3'){
            steps {
                echo "Sync project to s3 and validate"
            }
        }
        
        stage('Send Notification'){
            steps {
                echo "Send Notification"
            }
        }
    }
}