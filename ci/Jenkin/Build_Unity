pipeline {
    agent { label 'Kuzan-Window'}
    stages {
        stage('Checkout GIT') {
            steps {
				script {
					echo "Checkout branch = ${params.branch}"
					if (params.Clean) {
						echo "Will do clean before checkout"
						checkout scmGit(branches: [[name: '${branch}']], extensions: [submodule(recursiveSubmodules: true, reference: ''), cleanBeforeCheckout(deleteUntrackedNestedRepositories: true)], userRemoteConfigs: [])
					} else {
						checkout scmGit(branches: [[name: '${branch}']], extensions: [submodule(recursiveSubmodules: true, reference: '')], userRemoteConfigs: [])
					}
				}
            }
        }
        
